# Application runtime secrets are managed through SST and do not belong here.

# End-to-end testing
# Required by managed `pnpm test:e2e` runs. The auth secret must be at least
# 32 characters and is loaded into the isolated E2E SST stage as AuthSecret.
E2E_AUTH_SECRET=replace-with-a-32-plus-character-secret
E2E_USER_EMAIL=test-user@example.com
E2E_USER_PASSWORD=change-me-before-sharing

# Optional test-user customization. The default role is `normal`.
# E2E_USER_DISPLAY_NAME=Budgeted Test User
# E2E_USER_ROLE=normal

# Local development server
# All settings are optional. The defaults are localhost, port 3000, and HTTP.
# BUDGETED_DEV_HOSTNAME=localhost
# BUDGETED_DEV_PORT=3000
# BUDGETED_DEV_HTTPS=1

# Custom local HTTPS certificates
# Leave these unset to let the development wrapper generate certificates under
# .local/certificates. When supplying custom files, set both KEY and CERT; CA is
# optional.
# BUDGETED_DEV_HTTPS_KEY=./.local/certificates/localhost-key.pem
# BUDGETED_DEV_HTTPS_CERT=./.local/certificates/localhost.pem
# BUDGETED_DEV_HTTPS_CA=./.local/certificates/root-ca.pem

# Caller-managed Playwright server
# Set this only when Playwright should use an already-running compatible app
# instead of starting the managed E2E SST stage.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
