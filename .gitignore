npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
playwright-report/
test-results/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# open-next
.open-next
